{#
  Dev user show page header (heading and actions).

  No variables required from parent.
  min-h matches list header for consistent page chrome height.
#}

<div
  class="
    flex flex-row
    items-center justify-between
    min-h-10 xl:min-h-8
  "
>
  <h1
    class="
      inline-flex
      items-center
      gap-2 xl:gap-1.5
      shrink-0
      text-xl xl:text-lg
      font-semibold
      text-slate-900
    "
  >
    {{ ux_icon(
      'lucide:users',
      { class: 'size-6 xl:size-5 shrink-0' },
    ) }}

    <span>{{ 'dev.user.show.heading'|trans }}</span>
  </h1>

  <div
    class="
      flex
      gap-4 xl:gap-3
      shrink-0
    "
  >
    {% include 'components/button/icon_link.html.twig' with {
      href: '#',
      label: 'dev.user.button.edit'|trans,
      icon: 'lucide:pencil',
      size: 'responsive',
      shadow: true,
    } only %}

    {% include 'components/button/icon_button.html.twig' with {
      label: 'dev.user.button.copy_json'|trans,
      icon: 'lucide:braces',
      size: 'responsive',
      shadow: true,
    } only %}
  </div>
</div>
