{#
  Dev user show page header (heading and actions).

  No variables required from parent.
  min-h matches list header for consistent page chrome height.
#}

<div class="flex flex-row items-center justify-between min-h-8">
  <h1
    class="
      inline-flex items-center shrink-0 gap-2
      text-xl font-semibold text-foreground
    "
  >
    {{ ux_icon('lucide:users', { class: 'shrink-0 size-6' }) }}
    <span>{{ 'dev.user.show.heading'|trans }}</span>
  </h1>

  <div
    class="
      flex shrink-0 gap-4
      xl:gap-3
    "
  >
    {% include 'components/button/icon_link.html.twig' with {
      href: '#',
      label: 'dev.user.button.edit'|trans,
      icon: 'lucide:pencil',
      size: 'responsive',
      shadow: true,
    } only %}

    {% include 'components/button/icon_button.html.twig' with {
      label: 'dev.user.button.copy_json'|trans,
      icon: 'lucide:braces',
      size: 'responsive',
      shadow: true,
    } only %}
  </div>
</div>
