{#
  Dev user show detail fields.

  Required variables (include from parent):
  - user: UserRecord
#}

{% set timestampFields = [
  {
    label: 'dev.user.column.created_at',
    value: user.createdAt,
  },
  {
    label: 'dev.user.column.updated_at',
    value: user.updatedAt,
  },
  {
    label: 'dev.user.column.disabled_at',
    value: user.disabledAt,
  },
  {
    label: 'dev.user.column.suspended_at',
    value: user.suspendedAt,
  },
  {
    label: 'dev.user.column.deleted_at',
    value: user.deletedAt,
  },
] %}

<div
  class="
    flex flex-col gap-4 min-w-0 w-full
    px-6 py-4 bg-surface border border-line
    md:flex-row md:items-start md:gap-8
  "
>
  <dl class="flex flex-col gap-4 min-w-0 max-w-lg w-full">
    <div class="flex flex-col gap-1">
      <dt class="text-xs text-foreground-muted">
        {{ 'dev.user.column.id'|trans }}
      </dt>

      <dd class="flex items-center gap-1 min-w-0">
        <code class="font-mono text-sm text-foreground break-all" title="{{ user.id }}">
          {{ user.id }}
        </code>
        {% include 'components/button/clipboard_button.html.twig' with {
          text: user.id,
          copyLabel: 'dev.user.button.copy_id'|trans,
          copiedLabel: 'dev.user.button.copied_id'|trans,
        } only %}
      </dd>
    </div>

    <div class="flex flex-col gap-1">
      <dt class="text-xs text-foreground-muted">
        {{ 'dev.user.column.email'|trans }}
      </dt>

      <dd class="flex items-center gap-1 min-w-0">
        <span class="font-mono text-sm text-foreground break-all" title="{{ user.email }}">
          {{ user.email }}
        </span>
        {% include 'components/button/clipboard_button.html.twig' with {
          text: user.email,
          copyLabel: 'dev.user.button.copy_email'|trans,
          copiedLabel: 'dev.user.button.copied_email'|trans,
        } only %}
      </dd>
    </div>

    <div class="flex flex-col gap-1">
      <dt class="text-xs text-foreground-muted">
        {{ 'dev.user.column.status'|trans }}
      </dt>

      <dd>
        {% include 'components/user_status.html.twig' with {
          user: user,
          variant: 'badge',
        } only %}
      </dd>
    </div>
  </dl>

  <dl class="flex flex-wrap gap-4 min-w-0 max-w-[calc(2*11rem+1rem)]">
    {% for field in timestampFields %}
      <div class="flex flex-col shrink-0 gap-1 w-44">
        <dt class="text-xs text-foreground-muted whitespace-nowrap">
          {{ field.label|trans }}
        </dt>

        <dd class="font-mono text-xs text-foreground whitespace-nowrap">
          {% if field.value %}
            <time datetime="{{ field.value|date('c') }}">
              {{ field.value|date('Y-m-d H:i:s') }}
            </time>
          {% else %}
            —
          {% endif %}
        </dd>
      </div>
    {% endfor %}
  </dl>
</div>
