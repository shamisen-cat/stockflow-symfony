{#
  Dev user list table header cells.

  Required variables (include from parent):
  - currentKey: active sort key (must match SORT_MAP in UserReader)
  - currentDirection: 'asc' or 'desc'

  sortColumns.widthClass: Tailwind width utility, or '' for the flexible
  column that absorbs remaining width under table-fixed (email).
#}

{% include 'components/list/static_th.html.twig' with {
  label: 'dev.user.column.status'|trans,
  widthClass: 'w-16',
} only %}

{% set sortColumns = [
  {
    label: 'dev.user.column.id'|trans,
    sortKey: 'id',
    widthClass: 'w-32',
  },
  {
    label: 'dev.user.column.email'|trans,
    sortKey: 'email',
    widthClass: '',
  },
  {
    label: 'dev.user.column.updated_at'|trans,
    sortKey: 'updated_at',
    widthClass: 'w-40',
  },
] %}

{% for column in sortColumns %}
  {% include 'components/list/sortable_th.html.twig' with {
    label: column.label,
    sortKey: column.sortKey,
    currentKey: currentKey,
    currentDirection: currentDirection,
    widthClass: column.widthClass,
  } only %}
{% endfor %}

{% include 'components/list/static_th.html.twig' with {
  label: 'dev.user.column.actions'|trans,
  widthClass: 'w-28',
} only %}
