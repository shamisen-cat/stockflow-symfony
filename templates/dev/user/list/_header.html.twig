{#
  Dev user list page header (heading and actions).

  No variables required from parent.
  CSV export preserves the current request query string via app.request.
#}

<div class="flex flex-row items-center justify-between min-h-8">
  <h1
    class="
      inline-flex items-center shrink-0 gap-2
      text-xl font-semibold text-foreground
    "
  >
    {{ ux_icon('lucide:users', { class: 'shrink-0 size-6' }) }}
    <span>{{ 'dev.user.heading'|trans }}</span>
  </h1>

  <div
    class="
      flex shrink-0 gap-4
      xl:gap-3
    "
  >
    {% include 'components/button/icon_link.html.twig' with {
      href: path('app_dev_users_new'),
      label: 'dev.user.button.create'|trans,
      icon: 'lucide:plus',
      size: 'responsive',
      shadow: true,
    } only %}

    {% include 'components/button/icon_link.html.twig' with {
      href: path(
        'app_dev_users_export',
        app.request.query.all,
      ),
      label: 'dev.user.button.csv_download'|trans,
      icon: 'lucide:download',
      size: 'responsive',
      shadow: true,
    } only %}
  </div>
</div>
