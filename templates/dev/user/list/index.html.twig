{#
  Dev user list page (UserDevController::index).

  Variables from the controller:
  - users: UserRecord[] current page results
  - pagination: Pagerfanta instance
  - currentKey: active sort key (id, email, updated_at)
  - currentDirection: 'asc' or 'desc'
  - searchEmail: current email search query (empty string when unset)
  - sidebarLinks: DevSidebarLink[] parent sidebar navigation links
  - sidebarSubLinks: DevSidebarLink[] sub links for the current section
  - currentSection: DevSidebarLinkId parent section id
  - currentLink: DevSidebarLinkId active page link id
#}

{% extends 'layout/two_column.html.twig' %}

{% block title %}{{ 'dev.user.title'|trans }}{% endblock %}

{% block sidebar %}
  {% include 'components/sidebar.html.twig' with {
    sidebarLinks: sidebarLinks,
    sidebarSubLinks: sidebarSubLinks,
    currentSection: currentSection,
    currentLink: currentLink,
  } only %}
{% endblock %}

{% block main %}
  <div class="flex flex-col flex-1 min-h-0">
    <div class="shrink-0 overflow-y-auto scrollbar-gutter-stable">
      <div class="max-w-5xl w-full mx-auto px-4 py-2">
        {% include 'components/flash_messages.html.twig' %}

        <header>
          {% include 'dev/user/list/_header.html.twig' only %}
        </header>
      </div>
    </div>

    <div class="flex-1 overflow-auto scrollbar-gutter-stable min-h-0">
      <div
        class="
          min-w-180 max-w-5xl w-full mx-auto
          px-4 pt-2 pb-[max(1rem,env(safe-area-inset-bottom))]
        "
      >
        <div class="mb-2">
          {% include 'dev/user/list/_search_form.html.twig' with {
            searchEmail: searchEmail,
          } only %}
        </div>

        <section class="bg-surface border-x border-b border-line">
          <table
            class="
              table-fixed w-full border-separate border-spacing-0
              text-left text-xs text-foreground
            "
          >
            <thead>
              <tr>
                {% include 'dev/user/list/_table_head.html.twig' with {
                  currentKey: currentKey,
                  currentDirection: currentDirection,
                } only %}
              </tr>
            </thead>

            <tbody
              class="
                [&_tr:not(:first-child)_td]:border-t
                [&_tr:not(:first-child)_td]:border-line-subtle
              "
            >
              {% include 'dev/user/list/_table_body.html.twig' with {
                users: users,
              } only %}
            </tbody>
          </table>

          <footer>
            {% include 'components/list/pagination.html.twig' with {
              pagination: pagination,
            } only %}
          </footer>
        </section>
      </div>
    </div>
  </div>
{% endblock %}
