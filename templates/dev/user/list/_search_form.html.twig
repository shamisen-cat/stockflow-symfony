{#
  Dev user list email search form.

  Required variables (include from parent):
  - searchEmail: current email query value
#}

<form
  method="get"
  action="{{ path('app_dev_users') }}"
  class="flex flex-col gap-4"
>
  <div class="flex flex-row items-end gap-4">
    <div class="w-full min-w-0 max-w-lg">
      {% include 'components/form/text_input.html.twig' with {
        type: 'search',
        id: 'search-email',
        name: 'email',
        label: 'dev.user.search.email_label'|trans,
        value: searchEmail,
        placeholder: 'dev.user.search.email_placeholder'|trans,
        autocomplete: 'off',
      } only %}
    </div>

    <div class="flex shrink-0 gap-3">
      {% include 'components/button/primary_button.html.twig' with {
        label: 'dev.user.search.submit'|trans,
      } only %}

      {% if searchEmail %}
        {% include 'components/button/outline_link.html.twig' with {
          href: path('app_dev_users'),
          label: 'dev.user.search.clear'|trans,
        } only %}
      {% endif %}
    </div>
  </div>

  <details class="group flex flex-col gap-2">
    <summary
      class="
        inline-flex self-start items-center gap-1
        rounded
        text-sm text-slate-700
        cursor-pointer
        select-none
        transition
        hover:text-slate-900
        focus:outline-none
        focus:ring-2 focus:ring-offset-2 focus:ring-slate-700
      "
    >
      {{ 'dev.user.search.details'|trans }}
    </summary>

    <div></div>
  </details>
</form>
