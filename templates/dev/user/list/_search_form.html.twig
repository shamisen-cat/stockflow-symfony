{#
  Dev user list email search form.

  Required variables (include from parent):
  - searchEmail: current email query value
#}

<form
  method="get"
  action="{{ path('app_dev_users') }}"
  class="
    flex flex-col
    gap-4
  "
>
  <div
    class="
      flex flex-row
      items-end
      gap-4
    "
  >
    <div
      class="
        min-w-0 max-w-lg
        w-full
      "
    >
      {% include 'components/form/text_input.html.twig' with {
        type: 'search',
        id: 'search-email',
        name: 'email',
        label: 'dev.user.search.email_label'|trans,
        value: searchEmail,
        placeholder: 'dev.user.search.email_placeholder'|trans,
        autocomplete: 'off',
      } only %}
    </div>

    <div
      class="
        flex
        gap-2
        shrink-0
      "
    >
      {% include 'components/button/primary_button.html.twig' with {
        label: 'dev.user.search.submit'|trans,
        shadow: true,
      } only %}

      {% if searchEmail %}
        {% include 'components/button/outline_link.html.twig' with {
          href: path('app_dev_users'),
          label: 'dev.user.search.clear'|trans,
          size: 'responsive',
          shadow: true,
        } only %}
      {% endif %}
    </div>
  </div>

  <details
    class="
      group/search-details
      flex flex-col
      gap-2
    "
  >
    <summary
      class="
        inline-flex
        items-center
        self-start
        gap-1
        rounded
        focus:outline-none
        focus:ring-2
        focus:ring-offset-2
        focus:ring-blue-400
        text-sm
        text-slate-700 hover:text-slate-900
        transition
        cursor-pointer
        select-none
      "
    >
      {{ 'dev.user.search.details'|trans }}
    </summary>

    <div>test</div>
  </details>
</form>
