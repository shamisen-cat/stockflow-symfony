{#
  Dev user list table body rows.

  Required variables (include from parent):
  - users: UserRecord[] current page results
#}

{% for user in users %}
  <tr class="hover:bg-slate-100">
    <td class="px-4 py-2">
      {% include 'components/user_status.html.twig' with {
        user: user,
        variant: 'icon',
      } only %}
    </td>

    <td class="px-4 py-2">
      <div
        class="
          flex
          items-center
          gap-1
        "
      >
        <code
          class="font-mono"
          title="{{ user.id }}"
        >
          {{ user.id|slice(0, 8) }}…
        </code>

        {% include 'components/button/clipboard_button.html.twig' with {
          text: user.id,
          copyLabel: 'dev.user.button.copy_id'|trans,
          copiedLabel: 'dev.user.button.copied_id'|trans,
        } only %}
      </div>
    </td>

    <td class="px-4 py-2">
      <div
        class="
          flex
          items-center
          gap-1
          min-w-0 max-w-full
        "
      >
        <span
          class="
            min-w-0
            truncate
            font-mono
          "
          title="{{ user.email }}"
        >
          {{ user.email }}
        </span>

        {% include 'components/button/clipboard_button.html.twig' with {
          text: user.email,
          copyLabel: 'dev.user.button.copy_email'|trans,
          copiedLabel: 'dev.user.button.copied_email'|trans,
        } only %}
      </div>
    </td>

    <td
      class="
        px-4 py-2
        font-mono
        whitespace-nowrap
      "
    >
      <time datetime="{{ user.updatedAt|date('c') }}">
        {{ user.updatedAt|date('Y-m-d H:i') }}
      </time>
    </td>

    <td class="px-4 py-1">
      <div
        class="
          flex
          items-center justify-end
          gap-3
        "
      >
        {% include 'components/button/icon_link.html.twig' with {
          href: path(
            'app_dev_users_show',
            { id: user.id },
          ),
          label: 'dev.user.button.show'|trans,
          icon: 'lucide:eye',
          size: 'sm',
          shadow: true,
        } only %}

        {% include 'components/button/icon_button.html.twig' with {
          label: 'dev.user.button.copy_json'|trans,
          icon: 'lucide:braces',
          size: 'sm',
          shadow: true,
          tabindex: -1,
        } only %}
      </div>
    </td>
  </tr>
{% else %}
  <tr>
    <td
      colspan="5"
      class="
        px-4 py-12
        text-center
      "
    >
      {{ 'dev.user.empty'|trans }}
    </td>
  </tr>
{% endfor %}
