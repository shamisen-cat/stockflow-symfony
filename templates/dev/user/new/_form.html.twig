{#
  Dev user new form.

  Required variables (include from parent):
  - email: string value for the email input
  - error: string|null error code for field highlighting (e.g. email.invalid_format)
#}

{% set emailHasError = false %}
{% set passwordHasError = false %}

{% if error is not null %}
  {% set emailHasError = error starts with 'email.' or error == 'user.already_exists' %}
  {% set passwordHasError = error starts with 'password.' %}
{% endif %}

<form
  method="post"
  action="{{ path('app_dev_users_new') }}"
  novalidate
  class="w-full max-w-lg"
>
  <div
    class="mb-4"
    data-controller="email-generator"
    data-email-generator-input-id-value="email"
  >
    <div class="mb-2">
      {% include 'components/form/text_input.html.twig' with {
        type: 'email',
        id: 'email',
        name: 'email',
        label: 'dev.user.create.email_label'|trans,
        value: email,
        placeholder: 'dev.user.create.email_placeholder'|trans,
        autocomplete: 'off',
        autofocus: true,
        invalid: emailHasError,
      } only %}
    </div>

    <div class="flex flex-col items-start gap-3">
      {% include 'components/form/radio_group.html.twig' with {
        legend: 'dev.user.create.email_local_part_length'|trans,
        name: 'email-local-part-length',
        options: [
          { value: '8', label: '8' },
          { value: '16', label: '16' },
          { value: '32', label: '32' },
        ],
        checkedValue: '16',
        targetController: 'email-generator',
        targetName: 'length',
      } only %}

      <button
        type="button"
        class="
          inline-flex items-center justify-center
          px-3 py-1.5
          bg-blue-50 hover:bg-blue-100
          border border-blue-200
          rounded-lg shadow-sm
          text-xs font-medium
          text-blue-700 hover:text-blue-900
          focus:outline-none
          focus:ring-2 focus:ring-slate-700
          transition
        "
        data-action="click->email-generator#generate"
      >
        {{ 'dev.user.create.email_generate_random'|trans }}
      </button>
    </div>
  </div>

  <div class="mb-6">
    {% include 'components/form/password_input.html.twig' with {
      id: 'password',
      name: 'password',
      label: 'dev.user.create.password_label'|trans,
      showLabel: 'login.password.show'|trans,
      hideLabel: 'login.password.hide'|trans,
      placeholder: 'dev.user.create.password_placeholder'|trans,
      autocomplete: 'new-password',
      invalid: passwordHasError,
    } only %}
  </div>

  <div class="mb-8">
    <input
      type="hidden"
      name="_token"
      value="{{ csrf_token('dev_user_create') }}"
    >

    {% include 'components/button/primary_button.html.twig' with {
      label: 'dev.user.create.submit'|trans,
      fullWidth: true,
    } only %}
  </div>

  {% include 'components/button/outline_link.html.twig' with {
    href: path('app_dev_users'),
    label: 'dev.user.create.cancel'|trans,
    icon: 'lucide:arrow-left',
  } only %}
</form>
