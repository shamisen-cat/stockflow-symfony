{#
  Dev user new page header (heading only).

  No variables required from parent.
  min-h-11 keeps the heading aligned with list header actions.
#}

<div class="flex flex-row items-center min-h-11">
  <h1
    class="
      inline-flex items-center shrink-0 gap-2
      text-2xl font-semibold
    "
  >
    {{ ux_icon(
      'lucide:users',
      { class: 'size-6 shrink-0' },
    ) }}

    <span>{{ 'dev.user.create.heading'|trans }}</span>
  </h1>
</div>
