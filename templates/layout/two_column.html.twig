{#
  App shell with header, sidebar, and main (extends only).

  Blocks:
  - sidebar: navigation in the aside
  - main: primary page content
#}

{% extends 'base.html.twig' %}

{% block body %}
  <body
    class="
      group/sidebar
      flex flex-col
      h-dvh
      overflow-hidden
      bg-slate-50
      text-slate-700
      antialiased
    "
    data-controller="sidebar"
    data-sidebar-open-value="false"
    data-sidebar-open-label-value="{{ 'layout.sidebar.open'|trans }}"
    data-sidebar-close-label-value="{{ 'layout.sidebar.close'|trans }}"
    data-action="keydown.esc@window->sidebar#closeOnEscape"
  >
    <header
      class="
        relative
        z-20
        flex
        items-center
        h-12 xl:h-10
        pl-2
        pr-18 xl:pr-4
        shrink-0
        bg-white
        border-b
        border-slate-200
      "
      data-sidebar-target="header"
    >
      <div
        class="
          flex
          items-center justify-between
          min-w-0 w-full
        "
      >
        <a
          href="#"
          class="
            inline-flex
            items-center justify-center
            gap-1.5 xl:gap-1
            h-10 xl:h-8
            px-2
            shrink-0
            rounded
            focus:outline-none
            focus:ring-2
            focus:ring-blue-400
            text-lg xl:text-base
            font-semibold
            text-slate-900 hover:text-slate-700
            transition
            select-none
          "
        >
          {{ ux_icon(
            'lucide:package',
            { class: 'size-5 xl:size-4 shrink-0' },
          ) }}

          <span>Stockflow</span>
        </a>

        <div
          class="
            flex
            items-center
            shrink-0
          "
        >
          <a
            href="#"
            class="
              inline-flex
              items-center justify-center
              w-10 xl:w-8
              h-10 xl:h-8
              hover:bg-slate-100
              rounded
              focus:outline-none
              focus:ring-2
              focus:ring-blue-400
              text-slate-700 hover:text-slate-900
              transition
              select-none
            "
            aria-label="{{ 'layout.user_settings'|trans }}"
          >
            {{ ux_icon(
              'lucide:circle-user',
              { class: 'size-7 xl:size-6' },
            ) }}
          </a>
        </div>
      </div>
    </header>

    <button
      type="button"
      class="
        group/toggle
        fixed
        top-1 right-4 z-50
        xl:hidden
        inline-flex
        items-center justify-center
        w-10 h-10
        bg-transparent hover:bg-slate-100
        rounded
        focus:outline-none
        focus:ring-2
        focus:ring-blue-400
        transition
        select-none
      "
      aria-label="{{ 'layout.sidebar.open'|trans }}"
      aria-controls="app-sidebar"
      aria-expanded="false"
      data-sidebar-target="toggle"
      data-action="click->sidebar#toggle"
    >
      {% include 'layout/_sidebar_toggle_icon.html.twig' %}
    </button>

    <div
      class="
        flex flex-1
        min-w-0 min-h-0
      "
    >
      <aside
        id="app-sidebar"
        tabindex="-1"
        class="
          fixed xl:static
          right-0
          z-40 xl:z-auto
          inset-y-0
          translate-x-full xl:translate-x-0
          max-xl:group-data-[sidebar-open-value=true]/sidebar:translate-x-0
          flex flex-col
          w-64 xl:w-52
          min-h-0
          xl:shrink-0
          bg-white
          xl:border-r
          xl:border-slate-200
          shadow-xl xl:shadow-none
          transition-transform duration-300
        "
        data-sidebar-target="sidebar"
      >
        <div
          class="
            xl:hidden
            flex
            items-center
            h-12
            pl-4 pr-15
            shrink-0
            border-b
            border-slate-200
          "
          >
          <span
            id="app-sidebar-title"
            class="
              text-sm
              text-slate-700
            "
          >
            {{ 'layout.menu'|trans }}
          </span>
        </div>

        <nav
          class="
            flex-1
            min-h-0
            overflow-y-auto
          "
        >
          {% block sidebar %}{% endblock %}
        </nav>

        <div
          class="
            pb-[max(0.75rem,env(safe-area-inset-bottom))]
            shrink-0
          "
        >
          <form
            method="post"
            action="{{ logout_path() }}"
          >
            <input
              type="hidden"
              name="_csrf_token"
              value="{{ csrf_token('logout') }}"
            >

            <button
              type="submit"
              class="
                inline-flex
                items-center
                gap-1.5 xl:gap-1
                w-full
                h-11 xl:h-8
                px-4
                hover:bg-slate-100
                focus:outline-none
                focus:ring-2
                focus:ring-inset
                focus:ring-blue-400
                text-sm xl:text-xs
                text-slate-700 hover:text-slate-900
                transition
                select-none
              "
              aria-label="{{ 'layout.logout'|trans }}"
            >
              {{ ux_icon(
                'lucide:log-out',
                { class: 'size-4 xl:size-3.5 shrink-0' },
              ) }}

              <span>{{ 'layout.logout'|trans }}</span>
            </button>
          </form>
        </div>
      </aside>

      <main
        class="
          flex flex-col flex-1
          min-w-0 min-h-0
          overflow-hidden
        "
        data-sidebar-target="main"
      >
        {% block main %}{% endblock %}
      </main>
    </div>

    <div
      class="
        fixed
        z-30
        inset-0
        xl:hidden
        bg-slate-900/50
        opacity-0
        max-xl:group-data-[sidebar-open-value=true]/sidebar:opacity-100
        transition-opacity duration-300
        pointer-events-none
        max-xl:group-data-[sidebar-open-value=true]/sidebar:pointer-events-auto
      "
      aria-hidden="true"
      data-action="click->sidebar#close"
    ></div>
  </body>
{% endblock %}
