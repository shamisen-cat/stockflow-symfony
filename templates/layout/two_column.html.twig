{#
  App shell with header, sidebar, and main (extends only).

  Blocks:
  - sidebar: navigation in the aside
  - main: primary page content
#}

{% extends 'base.html.twig' %}

{% block body %}
  <body
    class="
      group/sidebar
      flex flex-col overflow-hidden h-dvh
      bg-background text-foreground antialiased
    "
    data-controller="sidebar"
    data-sidebar-open-value="false"
    data-sidebar-open-label-value="{{ 'layout.sidebar.open'|trans }}"
    data-sidebar-close-label-value="{{ 'layout.sidebar.close'|trans }}"
    data-action="keydown.esc@window->sidebar#closeOnEscape"
  >
    <header
      class="
        relative z-20
        flex items-center shrink-0
        h-12 pl-2 pr-18 bg-surface border-b border-line
        xl:h-10 xl:pr-4
      "
      data-sidebar-target="header"
    >
      <div class="flex items-center justify-between min-w-0 w-full">
        <a
          href="#"
          class="
            inline-flex items-center justify-center shrink-0 gap-1.5
            h-10 px-2 rounded
            text-lg font-semibold text-foreground
            transition select-none
            xl:gap-1 xl:h-8 xl:text-base
            focus:outline-none focus:ring-2 focus:ring-outline
          "
        >
          {{ ux_icon('lucide:package', { class: 'shrink-0 size-5 xl:size-4' }) }}
          <span>Stockflow</span>
        </a>

        <div class="flex items-center shrink-0">
          <a
            href="#"
            class="
              inline-flex items-center justify-center
              w-10 h-10 rounded text-foreground
              transition select-none
              xl:w-8 xl:h-8
              focus:outline-none focus:ring-2 focus:ring-outline
            "
            aria-label="{{ 'layout.user_settings'|trans }}"
          >
            {{ ux_icon('lucide:circle-user', { class: 'size-7 xl:size-6' }) }}
          </a>
        </div>
      </div>
    </header>

    <button
      type="button"
      class="
        group/toggle
        fixed top-1 right-4 z-50
        inline-flex items-center justify-center
        w-10 h-10 bg-transparent rounded
        transition select-none
        xl:hidden
        hover:bg-hover
        focus:outline-none focus:ring-2 focus:ring-outline
      "
      aria-label="{{ 'layout.sidebar.open'|trans }}"
      aria-controls="app-sidebar"
      aria-expanded="false"
      data-sidebar-target="toggle"
      data-action="click->sidebar#toggle"
    >
      {% include 'layout/_sidebar_toggle_icon.html.twig' %}
    </button>

    <div class="flex flex-1 min-w-0 min-h-0">
      <aside
        id="app-sidebar"
        tabindex="-1"
        class="
          fixed inset-y-0 right-0 z-40 translate-x-full
          flex flex-col w-64 min-h-0 bg-surface border-line shadow-lg
          transition-transform duration-300
          xl:static xl:z-auto xl:shrink-0
          xl:w-52 xl:border-r xl:shadow-none
          xl:translate-x-0
          max-xl:group-data-[sidebar-open-value=true]/sidebar:translate-x-0
        "
        data-sidebar-target="sidebar"
      >
        <div
          class="
            flex items-center shrink-0
            h-12 pl-4 pr-15 border-b border-line
            xl:hidden
          "
          >
          <span id="app-sidebar-title" class="text-sm text-foreground">
            {{ 'layout.menu'|trans }}
          </span>
        </div>

        <nav class="flex-1 overflow-y-auto min-h-0">
          {% block sidebar %}{% endblock %}
        </nav>

        <div class="shrink-0 pb-[max(1rem,env(safe-area-inset-bottom))]">
          <form method="post" action="{{ logout_path() }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button
              type="submit"
              class="
                inline-flex items-center gap-1.5
                w-full h-11 px-4 bg-transparent
                text-sm text-foreground
                transition select-none
                xl:gap-1 xl:h-8 xl:text-xs
                hover:bg-hover
                focus:outline-none focus:ring-2 focus:ring-outline focus:ring-inset
              "
              aria-label="{{ 'layout.logout'|trans }}"
            >
              {{ ux_icon('lucide:log-out', { class: 'shrink-0 size-4 xl:size-3.5' }) }}
              <span>{{ 'layout.logout'|trans }}</span>
            </button>
          </form>
        </div>
      </aside>

      <main
        class="flex flex-col flex-1 overflow-hidden min-w-0 min-h-0"
        data-sidebar-target="main"
      >
        {% block main %}{% endblock %}
      </main>
    </div>

    <div
      class="
        fixed inset-0 z-30 opacity-0 bg-black/50
        transition-opacity duration-300
        pointer-events-none
        xl:hidden
        max-xl:group-data-[sidebar-open-value=true]/sidebar:opacity-100
        max-xl:group-data-[sidebar-open-value=true]/sidebar:pointer-events-auto
      "
      aria-hidden="true"
      data-action="click->sidebar#close"
    ></div>
  </body>
{% endblock %}
