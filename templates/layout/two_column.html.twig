{#
  App shell with header, sidebar, and main (extends only).

  Blocks:
  - sidebar: navigation in the aside
  - main: primary page content
#}

{% extends 'base.html.twig' %}

{% block body %}
  <body class="
      group/sidebar
      flex flex-col overflow-hidden
      h-dvh bg-slate-50
      text-slate-900 antialiased
    "
    data-controller="sidebar"
    data-sidebar-open-value="false"
    data-sidebar-open-label-value="{{ 'layout.sidebar.open'|trans }}"
    data-sidebar-close-label-value="{{ 'layout.sidebar.close'|trans }}"
  >
    <header
      class="
        relative z-20
        flex items-center shrink-0
        h-14 pr-19 bg-white
        border-b border-slate-200
        xl:h-12 xl:pr-4
      "
    >
      <div
        class="
          flex items-center justify-between
          w-full min-w-0
        "
      >
        <a
          href="#"
          class="
            inline-flex items-center justify-center shrink-0 gap-1
            min-w-0 min-h-11 px-4
            rounded-lg
            text-lg font-semibold text-slate-900
            transition
            xl:h-9
            hover:text-slate-700
            focus:outline-none
            focus:ring-2 focus:ring-slate-700
          "
        >
          {{ ux_icon(
            'lucide:package',
            { class: 'shrink-0 size-5' },
          ) }}

          <span>Stockflow</span>
        </a>

        <div class="flex items-center shrink-0">
          <a
            href="#"
            class="
              inline-flex items-center justify-center
              min-w-11 min-h-11
              rounded-lg
              text-slate-700
              transition
              xl:w-9 xl:h-9
              hover:bg-slate-100
              hover:text-slate-900
              focus:outline-none
              focus:ring-2 focus:ring-slate-700
            "
            aria-label="{{ 'layout.user_settings'|trans }}"
          >
            {{ ux_icon(
              'lucide:circle-user',
              { class: 'shrink-0 size-6' },
            ) }}
          </a>
        </div>
      </div>
    </header>

    <button
      type="button"
      class="
        group/toggle
        fixed top-1.5 right-4 z-50
        inline-flex items-center justify-center
        w-11 h-11 bg-transparent
        rounded-lg
        transition
        xl:hidden
        hover:bg-slate-100
        focus:outline-none
        focus:ring-2 focus:ring-slate-700
      "
      data-sidebar-target="toggle"
      data-action="click->sidebar#toggle"
      aria-label="{{ 'layout.sidebar.open'|trans }}"
      aria-controls="app-sidebar"
      aria-expanded="false"
    >
      <span class="relative block w-6 h-6">
        <span
          class="
            absolute top-0 left-0 origin-center
            block w-6 h-0.5 bg-slate-900
            transition-all duration-300
            group-aria-expanded/toggle:top-1/2
            group-aria-expanded/toggle:-translate-y-1/2
            group-aria-expanded/toggle:rotate-45
          "
        ></span>
        <span
          class="
            absolute top-2.5 left-0 origin-center
            block w-6 h-0.5 bg-slate-900
            transition-all duration-300
            group-aria-expanded/toggle:top-1/2
            group-aria-expanded/toggle:-translate-y-1/2
            group-aria-expanded/toggle:opacity-0
          "
        ></span>
        <span
          class="
            absolute top-5 left-0 origin-center
            block w-6 h-0.5 bg-slate-900
            transition-all duration-300
            group-aria-expanded/toggle:top-1/2
            group-aria-expanded/toggle:-translate-y-1/2
            group-aria-expanded/toggle:-rotate-45
          "
        ></span>
      </span>
    </button>

    <div
      class="
        flex flex-1
        min-w-0 min-h-0
      "
    >
      <aside
        id="app-sidebar"
        class="
          fixed right-0 z-40 inset-y-0 translate-x-full
          flex flex-col
          w-64 min-h-0 bg-white
          border-l border-slate-200 shadow-xl
          transition-transform duration-300
          xl:static xl:z-auto xl:translate-x-0
          xl:shrink-0
          xl:w-60
          xl:border-l-0 xl:border-r xl:shadow-none
          max-xl:group-data-[sidebar-open-value=true]/sidebar:translate-x-0
        "
        data-sidebar-target="sidebar"
        aria-hidden="true"
      >
        <div
          class="
            flex items-center shrink-0
            h-14 pl-4 pr-16
            border-b border-slate-200
            xl:hidden
          "
        >
          <span class="text-sm">
            {{ 'layout.menu'|trans }}
          </span>
        </div>

        <nav class="flex-1 overflow-y-auto min-h-0">
          {% block sidebar %}{% endblock %}
        </nav>

        <div
          class="
            shrink-0
            pb-[max(0.75rem,env(safe-area-inset-bottom))]
          "
        >
          <form
            method="post"
            action="{{ logout_path() }}"
          >
            <input
              type="hidden"
              name="_csrf_token"
              value="{{ csrf_token('logout') }}"
            >

            <button
              type="submit"
              class="
                inline-flex items-center gap-2
                w-full min-h-11 pl-4
                text-sm text-slate-700
                transition
                hover:bg-slate-100
                hover:text-slate-900
                focus:outline-none
                focus:ring-2 focus:ring-inset focus:ring-slate-700
              "
              aria-label="{{ 'layout.logout'|trans }}"
            >
              {{ ux_icon(
                'lucide:log-out',
                { class: 'shrink-0 size-4' },
              ) }}

              <span>{{ 'layout.logout'|trans }}</span>
            </button>
          </form>
        </div>
      </aside>

      <main
        class="
          flex flex-col flex-1 overflow-hidden
          min-w-0 min-h-0
        "
      >
        {% block main %}{% endblock %}
      </main>
    </div>

    <div
      class="
        fixed z-30 inset-0
        bg-slate-900/50
        opacity-0
        pointer-events-none
        transition-opacity duration-300
        xl:hidden
        max-xl:group-data-[sidebar-open-value=true]/sidebar:opacity-100
        max-xl:group-data-[sidebar-open-value=true]/sidebar:pointer-events-auto
      "
      data-sidebar-target="overlay"
      data-action="click->sidebar#close"
    ></div>
  </body>
{% endblock %}
