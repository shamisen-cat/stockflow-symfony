{#
  Login page (security login).

  Variables from the controller / security:
  - last_username: string last submitted username (email)
  - error: AuthenticationException|null login error when present
#}

{% extends 'layout/centered.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block content %}
  <section
    class="
      max-w-md w-full
      overflow-hidden
      border
      border-slate-200
      rounded
      shadow-sm
    "
  >
    <header
      class="
        flex
        items-center
        h-10
        px-4
        bg-white
        border-b
        border-slate-200
      "
    >
      <div
        class="
          inline-flex
          items-center
          gap-1.5
          text-lg
          font-semibold
          text-slate-900
        "
      >
        {{ ux_icon(
          'lucide:package',
          { class: 'size-5 shrink-0' },
        ) }}

        <span>Stockflow</span>
      </div>
    </header>

    <div
      class="
        flex flex-col
        gap-4
        p-8 pt-4
      "
    >
      <h1
        class="
          flex
          items-center justify-center
          gap-2 xl:gap-1.5
          text-xl xl:text-lg
          font-semibold
          text-slate-900
        "
      >
        {{ ux_icon(
          'lucide:log-in',
          { class: 'size-6 xl:size-5 shrink-0' },
        ) }}

        <span>{{ 'login.heading'|trans }}</span>
      </h1>

      {% if error %}
        <div
          role="alert"
          class="
            flex
            items-center
            gap-1.5
            px-4 py-2
            bg-red-50
            border
            border-red-200
            rounded
            text-sm
            text-red-700
          "
        >
          {{ ux_icon(
            'lucide:circle-alert',
            { class: 'size-4 shrink-0' },
          ) }}

          <span class="min-w-0">
            {{ error.messageKey|trans(error.messageData, 'security') }}
          </span>
        </div>
      {% endif %}

      <form
        method="post"
        action="{{ path('app_login') }}"
      >
        <p
          class="
            mb-4
            text-sm
            text-slate-700
          "
        >
          {{ 'login.instructions'|trans }}
        </p>

        <div class="mb-4">
          {% include 'components/form/text_input.html.twig' with {
            type: 'email',
            id: 'username',
            name: '_username',
            label: 'login.label.email'|trans,
            value: last_username,
            placeholder: 'login.placeholder.email'|trans,
            autocomplete: 'username',
            required: true,
            autofocus: true,
          } only %}
        </div>

        <div class="mb-6">
          {% include 'components/form/password_input.html.twig' with {
            id: 'password',
            name: '_password',
            label: 'login.label.password'|trans,
            showLabel: 'login.password.show'|trans,
            hideLabel: 'login.password.hide'|trans,
            required: true,
          } only %}
        </div>

        <input
          type="hidden"
          name="_csrf_token"
          value="{{ csrf_token('authenticate') }}"
        >

        {% include 'components/button/primary_button.html.twig' with {
          label: 'login.button.submit'|trans,
          fullWidth: true,
          shadow: true,
        } only %}
      </form>
    </div>
  </section>
{% endblock %}
