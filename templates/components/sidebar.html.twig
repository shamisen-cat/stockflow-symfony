{#
  Sidebar navigation.

  Required variables (include ... with):
  - sidebarLinks: list<DevSidebarLink> parent navigation links
  - sidebarSubLinks: list<DevSidebarLink> sub links for the current section
  - currentSection: DevSidebarLinkId parent section id
  - currentLink: DevSidebarLinkId active page link id
#}

{% set linkBase = '
  inline-flex items-center gap-1.5
  w-full h-11 pr-4 text-sm
  select-none
  xl:gap-1 xl:h-8 xl:text-xs
  focus:outline-none focus:ring-2 focus:ring-outline focus:ring-inset
' %}

{% set linkActive = linkBase ~ '
  pl-4 bg-selected text-selected-foreground
' %}

{% set linkInactive = linkBase ~ '
  pl-4 bg-transparent text-foreground
  transition
  hover:bg-hover
' %}

{% set linkSubActive = linkBase ~ '
  pl-6 bg-selected text-selected-foreground
' %}

{% set linkSubInactive = linkBase ~ '
  pl-6 bg-transparent text-foreground
  transition
  hover:bg-hover
' %}

<ul class="divide-y divide-line">
  {% for link in sidebarLinks %}
    {% set isCurrentPage = link.id == currentLink %}
    {% set isCurrentSection = link.id == currentSection %}

    <li>
      <a
        href="{{ link.href }}"
        class="{{ isCurrentPage ? linkActive : linkInactive }}"

        {% if isCurrentPage %}
          aria-current="page"
        {% endif %}
      >
        {{ ux_icon(link.icon, { class: 'shrink-0 size-4 xl:size-3.5' }) }}
        <span>{{ link.label|trans }}</span>
      </a>

      {% if isCurrentSection and sidebarSubLinks is not empty %}
        <ul>
          {% for subLink in sidebarSubLinks %}
            {% set isSubCurrentPage = subLink.id == currentLink %}

            <li>
              <a
                href="{{ subLink.href }}"
                class="{{ isSubCurrentPage ? linkSubActive : linkSubInactive }}"

                {% if isSubCurrentPage %}
                  aria-current="page"
                {% endif %}
              >
                {{ ux_icon(subLink.icon, { class: 'shrink-0 size-4 xl:size-3.5' }) }}
                <span>{{ subLink.label|trans }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
