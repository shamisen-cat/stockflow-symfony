{#
  Sidebar navigation.

  Required variables (include ... with):
  - sidebarLinks: list<DevSidebarLink> parent navigation links
  - sidebarSubLinks: list<DevSidebarLink> sub links for the current section
  - currentSection: DevSidebarLinkId parent section id
  - currentLink: DevSidebarLinkId active page link id
#}

{% set linkActive = '
  inline-flex
  items-center
  gap-1.5 xl:gap-1
  w-full
  h-11 xl:h-8
  px-4
  bg-slate-100
  focus:outline-none
  focus:ring-2
  focus:ring-inset
  focus:ring-blue-400
  text-sm xl:text-xs
  text-slate-900
' %}

{% set linkInactive = '
  inline-flex
  items-center
  gap-1.5 xl:gap-1
  w-full
  h-11 xl:h-8
  px-4
  hover:bg-slate-100
  focus:outline-none
  focus:ring-2
  focus:ring-inset
  focus:ring-blue-400
  text-sm xl:text-xs
  text-slate-700 hover:text-slate-900
  transition
' %}

{% set linkSubActive = '
  inline-flex
  items-center
  gap-1.5 xl:gap-1
  w-full
  h-11 xl:h-8
  pl-6 pr-4
  bg-slate-100
  focus:outline-none
  focus:ring-2
  focus:ring-inset
  focus:ring-blue-400
  text-sm xl:text-xs
  text-slate-900
' %}

{% set linkSubInactive = '
  inline-flex
  items-center
  gap-1.5 xl:gap-1
  w-full
  h-11 xl:h-8
  pl-6 pr-4
  hover:bg-slate-100
  focus:outline-none
  focus:ring-2
  focus:ring-inset
  focus:ring-blue-400
  text-sm xl:text-xs
  text-slate-700 hover:text-slate-900
  transition
' %}

<ul
  class="
    divide-y
    divide-slate-100
  "
>
  {% for link in sidebarLinks %}
    {% set isCurrentPage = link.id == currentLink %}
    {% set isCurrentSection = link.id == currentSection %}

    <li>
      <a
        href="{{ link.href }}"
        class="{{ isCurrentPage ? linkActive : linkInactive }}"

        {% if isCurrentPage %}
          aria-current="page"
        {% endif %}
      >
        {{ ux_icon(
          link.icon,
          { class: 'size-4 xl:size-3.5 shrink-0' },
        ) }}

        <span>{{ link.label|trans }}</span>
      </a>

      {% if isCurrentSection and sidebarSubLinks is not empty %}
        <ul>
          {% for subLink in sidebarSubLinks %}
            {% set isSubCurrentPage = subLink.id == currentLink %}

            <li>
              <a
                href="{{ subLink.href }}"
                class="{{ isSubCurrentPage ? linkSubActive : linkSubInactive }}"

                {% if isSubCurrentPage %}
                  aria-current="page"
                {% endif %}
              >
                {{ ux_icon(
                  subLink.icon,
                  { class: 'size-4 xl:size-3.5 shrink-0' },
                ) }}

                <span>{{ subLink.label|trans }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
