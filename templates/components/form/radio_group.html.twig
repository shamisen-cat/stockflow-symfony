{#
  Labeled radio group.

  Required variables (include ... with):
  - legend: visible group label
  - name: radio input name
  - options: list of { value: string, label: string }

  Optional variables:
  - checkedValue: selected value (defaults to empty)
  - targetController: when set with targetName, applied as Stimulus target controller
  - targetName: when set with targetController, applied as Stimulus target name
#}

{% set checkedValue = checkedValue|default('') %}

<fieldset class="flex flex-col">
  <legend class="text-sm text-foreground">
    {{ legend }}
  </legend>

  <div class="flex items-center gap-3 mt-1.5">
    {% for option in options %}
      <label
        class="
          inline-flex items-center gap-1.5
          text-sm text-foreground
        "
      >
        <span
          class="
            inline-flex rounded-full
            has-focus-visible:ring-2 has-focus-visible:ring-outline
          "
        >
          <input
            type="radio"
            name="{{ name }}"
            value="{{ option.value }}"

            {% if option.value == checkedValue %}
              checked
            {% endif %}

            class="
              h-4 w-4 accent-primary
              focus:outline-none
            "

            {% if targetController is defined and targetName is defined %}
              data-{{ targetController }}-target="{{ targetName }}"
            {% endif %}
          >
        </span>
        <span>{{ option.label }}</span>
      </label>
    {% endfor %}
  </div>
</fieldset>
