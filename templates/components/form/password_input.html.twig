{#
  Password input with show/hide toggle (password-visibility Stimulus).

  Required variables (include ... with):
  - id: input id (also used as the label for attribute and aria-controls)
  - name: input name
  - label: visible label text
  - showLabel: toggle title / aria-label when password is hidden
  - hideLabel: toggle title / aria-label when password is visible

  Optional variables:
  - value: input value (defaults to empty)
  - placeholder: when set, applied as placeholder
  - autocomplete: autocomplete value (defaults to current-password)
  - required: when true, marks input as required (defaults to false)
  - autofocus: when true, focuses the input on load (defaults to false)
  - invalid: when true, red border + aria-invalid (defaults to false)
  - errorMessage: when set, validation message shown below the input
#}

{% set value = value|default('') %}
{% set placeholder = placeholder|default('') %}
{% set autocomplete = autocomplete|default('current-password') %}
{% set required = required|default(false) %}
{% set autofocus = autofocus|default(false) %}
{% set invalid = invalid|default(false) %}
{% set errorMessage = errorMessage|default(null) %}

<div
  class="
    flex flex-col
    gap-1.5
  "
>
  <label
    for="{{ id }}"
    class="
      text-sm
      text-slate-700
    "
  >
    {{ label }}
  </label>

  <div
    class="
      flex
      items-stretch
    "
    data-controller="password-visibility"
    data-password-visibility-show-label-value="{{ showLabel }}"
    data-password-visibility-hide-label-value="{{ hideLabel }}"
  >
    <input
      type="password"
      id="{{ id }}"
      name="{{ name }}"
      value="{{ value }}"

      {% if placeholder != '' %}
        placeholder="{{ placeholder }}"
      {% endif %}

      autocomplete="{{ autocomplete }}"

      {% if required %}
        required
      {% endif %}

      {% if autofocus %}
        autofocus
      {% endif %}

      class="
        relative
        z-0 focus:z-10
        flex-1
        min-w-0
        h-10 xl:h-8
        px-4 xl:px-3
        bg-white
        border
        {{ invalid
          ? 'border-red-400 focus:border-transparent'
          : 'border-slate-200 focus:border-transparent'
        }}
        rounded-l
        focus:outline-none
        focus:ring-2
        focus:ring-blue-400
        text-sm
        text-slate-700
        placeholder:text-slate-500
        transition
      "
      aria-invalid="{{ invalid ? 'true' : 'false' }}"

      {% if errorMessage %}
        aria-describedby="{{ id }}-error"
      {% endif %}

      data-password-visibility-target="input"
    >

    <button
      type="button"
      class="
        group/toggle
        relative
        z-0 focus:z-10
        inline-flex
        items-center justify-center
        -ml-px
        w-10 xl:w-8
        shrink-0
        bg-white hover:bg-slate-100
        border
        {{ invalid
          ? 'border-red-400 focus:border-transparent'
          : 'border-slate-200 focus:border-transparent'
        }}
        rounded-r
        focus:outline-none
        focus:ring-2
        focus:ring-blue-400
        text-slate-700 hover:text-slate-900
        transition
        select-none
      "
      title="{{ showLabel }}"
      aria-label="{{ showLabel }}"
      aria-controls="{{ id }}"
      aria-pressed="false"
      data-password-visibility-target="toggle"
      data-action="click->password-visibility#toggle"
    >
      <span
        class="
          group-aria-pressed/toggle:hidden
        "
      >
        {{ ux_icon(
          'lucide:eye',
          { class: 'size-5 xl:size-4' },
        ) }}
      </span>

      <span
        class="
          group-aria-pressed/toggle:block
          hidden
        "
      >
        {{ ux_icon(
          'lucide:eye-off',
          { class: 'size-5 xl:size-4' },
        ) }}
      </span>
    </button>
  </div>

  {% if errorMessage %}
    <p
      id="{{ id }}-error"
      role="alert"
      class="
        flex
        items-center
        gap-1
        text-xs
        text-red-500
      "
    >
      {{ ux_icon(
        'lucide:circle-alert',
        { class: 'size-3 shrink-0' },
      ) }}

      <span>{{ errorMessage }}</span>
    </p>
  {% endif %}
</div>
