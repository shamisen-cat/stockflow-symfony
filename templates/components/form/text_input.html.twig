{#
  Labeled text input (email, search, text, etc.).

  Required variables (include ... with):
  - id: input id (also used as the label for attribute)
  - name: input name
  - label: visible label text

  Optional variables:
  - type: input type (defaults to text)
  - value: input value (defaults to empty)
  - placeholder: when set, applied as placeholder
  - autocomplete: when set, applied as autocomplete
  - required: when true, marks input as required (defaults to false)
  - autofocus: when true, focuses the input on load (defaults to false)
  - invalid: when true, red border + aria-invalid (defaults to false)
  - errorMessage: when set, validation message shown below the input
#}

{% set type = type|default('text') %}
{% set value = value|default('') %}
{% set placeholder = placeholder|default('') %}
{% set autocomplete = autocomplete|default('') %}
{% set required = required|default(false) %}
{% set autofocus = autofocus|default(false) %}
{% set invalid = invalid|default(false) %}
{% set errorMessage = errorMessage|default(null) %}

<div class="flex flex-col gap-1.5">
  <label for="{{ id }}" class="text-sm text-foreground-muted">
    {{ label }}
  </label>

  <input
    type="{{ type }}"
    id="{{ id }}"
    name="{{ name }}"
    value="{{ value }}"

    {% if placeholder != '' %}
      placeholder="{{ placeholder }}"
    {% endif %}

    {% if autocomplete != '' %}
      autocomplete="{{ autocomplete }}"
    {% endif %}

    {% if required %}
      required
    {% endif %}

    {% if autofocus %}
      autofocus
    {% endif %}

    class="
      block w-full h-10 px-4 bg-surface border rounded
      {{ invalid
        ? 'border-danger-line-emphasis focus:border-transparent'
        : 'border-line focus:border-transparent'
      }}
      text-sm text-foreground
      placeholder:text-foreground-muted
      transition
      xl:h-8 xl:px-3
      focus:outline-none focus:ring-2 focus:ring-outline
    "
    aria-invalid="{{ invalid ? 'true' : 'false' }}"

    {% if errorMessage %}
      aria-describedby="{{ id }}-error"
    {% endif %}
  >

  {% if errorMessage %}
    <p
      id="{{ id }}-error"
      role="alert"
      class="
        flex items-center gap-1
        text-xs text-danger-foreground
      "
    >
      {{ ux_icon('lucide:circle-alert', { class: 'shrink-0 size-3' }) }}
      <span>{{ errorMessage }}</span>
    </p>
  {% endif %}
</div>
