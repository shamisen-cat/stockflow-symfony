{#
  Square icon button (table actions, etc.).

  Required variables (include ... with):
  - label: title / aria-label text
  - icon: UX Iconify name (e.g. lucide:braces)

  Optional variables:
  - type: button type (defaults to button)
  - size: 'sm' | 'md' (default) | 'lg' | 'responsive' (md below xl, sm at xl+)
  - shadow: when true, adds shadow-sm (defaults to false)
  - tabindex: when set, applied to the button element
#}

{% set type = type|default('button') %}
{% set size = size|default('md') %}
{% set shadow = shadow|default(false) %}

{% if size == 'sm' %}
  {% set buttonSize = 'w-8 h-8' %}
  {% set iconSize = 'size-4' %}
{% elseif size == 'lg' %}
  {% set buttonSize = 'w-12 h-12' %}
  {% set iconSize = 'size-6' %}
{% elseif size == 'responsive' %}
  {% set buttonSize = 'w-10 h-10 xl:w-8 xl:h-8' %}
  {% set iconSize = 'size-5 xl:size-4' %}
{% else %}
  {% set buttonSize = 'w-10 h-10' %}
  {% set iconSize = 'size-5' %}
{% endif %}

<button
  type="{{ type }}"

  {% if tabindex is defined %}
    tabindex="{{ tabindex }}"
  {% endif %}

  class="
    inline-flex items-center justify-center shrink-0
    {{ buttonSize }}
    bg-surface border border-line rounded
    {{ shadow ? 'shadow-sm' : '' }}
    text-foreground
    transition select-none
    hover:bg-hover
    focus:border-transparent
    focus:outline-none focus:ring-2 focus:ring-outline
  "
  title="{{ label }}"
  aria-label="{{ label }}"
>
  {{ ux_icon(icon, { class: iconSize }) }}
</button>
