{#
  Square icon button (table actions, etc.).

  Required variables (include ... with):
  - label: title / aria-label text
  - icon: UX Iconify name (e.g. lucide:braces)

  Optional variables:
  - type: button type (defaults to button)
  - size: 'md' (default) | 'sm'
  - shadow: when true, adds shadow-sm (defaults to false)
  - tabindex: when set, applied to the button element
#}

{% set type = type|default('button') %}
{% set size = size|default('md') %}
{% set shadow = shadow|default(false) %}

{% if size == 'sm' %}
  {% set buttonSize = 'w-8 h-8' %}
  {% set iconSize = 'size-4' %}
{% else %}
  {% set buttonSize = 'w-11 h-11' %}
  {% set iconSize = 'size-5' %}
{% endif %}

<button
  type="{{ type }}"

  {% if tabindex is defined %}
    tabindex="{{ tabindex }}"
  {% endif %}

  class="
    inline-flex
    items-center justify-center
    shrink-0
    {{ buttonSize }}
    bg-white hover:bg-slate-100
    border border-slate-200
    rounded-lg
    {{ shadow ? 'shadow-sm' : '' }}
    focus:outline-none
    focus:ring-2 focus:ring-slate-700
    text-slate-700 hover:text-slate-900
    transition
  "
  title="{{ label }}"
  aria-label="{{ label }}"
>
  {{ ux_icon(
    icon,
    { class: iconSize },
  ) }}
</button>
