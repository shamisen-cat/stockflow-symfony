{#
  Primary action button (blue filled).

  Required variables (include ... with):
  - label: visible button text

  Optional variables:
  - type: button type (defaults to submit)
  - fullWidth: when true, adds w-full (defaults to false)
  - shadow: when true, adds shadow-sm (defaults to false)
#}

{% set type = type|default('submit') %}
{% set fullWidth = fullWidth|default(false) %}
{% set shadow = shadow|default(false) %}

<button
  type="{{ type }}"
  class="
    inline-flex
    items-center justify-center
    {{ fullWidth ? 'w-full' : '' }}
    h-10 xl:h-8
    px-4 xl:px-3
    shrink-0
    bg-blue-600 hover:bg-blue-700
    rounded
    {{ shadow ? 'shadow-sm' : '' }}
    focus:outline-none
    focus:ring-2
    focus:ring-offset-2
    focus:ring-blue-400
    text-sm xl:text-xs
    font-medium
    text-white
    whitespace-nowrap
    transition
    select-none
  "
>
  {{ label }}
</button>
