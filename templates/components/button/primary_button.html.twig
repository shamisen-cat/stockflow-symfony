{#
  Primary action button (blue filled).

  Required variables (include ... with):
  - label: visible button text

  Optional variables:
  - type: button type (defaults to submit)
  - fullWidth: when true, adds w-full (defaults to false)
  - shadow: when true, adds shadow-sm (defaults to false)
#}

{% set type = type|default('submit') %}
{% set fullWidth = fullWidth|default(false) %}
{% set shadow = shadow|default(false) %}

<button
  type="{{ type }}"
  class="
    inline-flex items-center justify-center shrink-0
    {{ fullWidth ? 'w-full' : '' }}
    h-10 px-4 bg-primary rounded
    {{ shadow ? 'shadow-sm' : '' }}
    text-sm font-medium text-primary-foreground whitespace-nowrap
    transition select-none
    xl:h-8 xl:px-3 xl:text-xs
    hover:bg-primary-hover
    focus:outline-none focus:ring-2 focus:ring-outline focus:ring-offset-2
  "
>
  {{ label }}
</button>
