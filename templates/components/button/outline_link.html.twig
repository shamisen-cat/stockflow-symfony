{#
  Outline action link.

  Required variables (include ... with):
  - href: link destination
  - label: visible link text

  Optional variables:
  - icon: UX Iconify name (e.g. lucide:arrow-left)
  - size: 'sm' | 'md' (default) | 'lg' | 'responsive' (md below xl, sm at xl+)
  - tone: 'danger' | 'default' (default)
  - fullWidth: when true, adds w-full (defaults to false)
  - shadow: when true, adds shadow-sm (defaults to false)
#}

{% set size = size|default('md') %}
{% set tone = tone|default('default') %}
{% set fullWidth = fullWidth|default(false) %}
{% set shadow = shadow|default(false) %}

{% if size == 'sm' %}
  {% set sizeClass = 'gap-1 h-8 px-3 text-xs' %}
  {% set iconSize = 'size-3.5' %}
{% elseif size == 'lg' %}
  {% set sizeClass = 'gap-2 h-12 px-5 text-base' %}
  {% set iconSize = 'size-4.5' %}
{% elseif size == 'responsive' %}
  {% set sizeClass = '
    gap-1.5 h-10 px-4 text-sm
    xl:gap-1 xl:h-8 xl:px-3 xl:text-xs
  ' %}
  {% set iconSize = 'size-4 xl:size-3.5' %}
{% else %}
  {% set sizeClass = 'gap-1.5 h-10 px-4 text-sm' %}
  {% set iconSize = 'size-4' %}
{% endif %}

{% if tone == 'danger' %}
  {% set toneClass = '
    bg-danger border-danger-line text-danger-foreground
    hover:bg-danger-hover
  ' %}
{% else %}
  {% set toneClass = '
    bg-surface border-line text-foreground
    hover:bg-hover
  ' %}
{% endif %}

<a
  href="{{ href }}"
  class="
    inline-flex items-center justify-center shrink-0
    border rounded font-medium whitespace-nowrap
    {{ sizeClass }}
    {{ toneClass }}
    {{ fullWidth ? 'w-full' : '' }}
    {{ shadow ? 'shadow-sm' : '' }}
    transition select-none
    focus:border-transparent
    focus:outline-none focus:ring-2 focus:ring-outline
  "
>
  {% if icon is defined and icon %}
    {{ ux_icon(icon, { class:iconSize ~ ' shrink-0' }) }}
  {% endif %}

  <span>{{ label }}</span>
</a>
