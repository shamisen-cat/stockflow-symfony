{#
  Static table header cell.

  Required variables (include ... with):
  - label: Column header text

  Optional variables:
  - widthClass: Tailwind width utility (e.g. 'w-28'); omitted when unset
#}

{% set widthClass = widthClass|default('') %}

<th
  scope="col"
  class="
    sticky
    top-0 z-10
    px-4 py-2.5
    {{ widthClass }}
    bg-slate-50
    border-b border-slate-200
    whitespace-nowrap
    text-slate-700
  "
>
  {{ label }}
</th>
