{#
  Static table header cell.

  Required variables (include ... with):
  - label: column header text

  Optional variables:
  - widthClass: when set, applied as a Tailwind width utility (e.g. w-28)
  - alignClass: when set, applied as a Tailwind text-align utility (e.g. text-right)
#}

{% set widthClass = widthClass|default('') %}
{% set alignClass = alignClass|default('') %}

<th
  scope="col"
  class="
    sticky
    top-0 z-10
    {{ widthClass }}
    h-10 xl:h-8
    px-4 xl:px-3
    bg-slate-50
    border-b
    border-slate-200
    {{ alignClass }}
    text-xs
    text-slate-700
    whitespace-nowrap
  "
>
  {{ label }}
</th>
