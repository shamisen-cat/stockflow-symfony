{#
  Pagination navigation for server-side paginated lists.

  Required variables (include ... with):
  - pagination: Pagerfanta instance (from the controller)
#}

{% if pagination.nbResults > 0 %}
  {% set buttonEnabled = '
    inline-flex items-center justify-center shrink-0
    w-8 h-8 bg-surface border border-line rounded shadow-sm
    text-foreground
    transition select-none
    hover:bg-hover
    focus:border-transparent
    focus:outline-none focus:ring-2 focus:ring-outline
  ' %}

  {% set buttonDisabled = '
    inline-flex items-center justify-center shrink-0
    w-8 h-8 bg-surface border border-line-subtle rounded
    text-foreground-subtle
    select-none
  ' %}

  <nav
    class="
      flex flex-row items-center justify-between
      h-10 px-4 border-t border-line
    "
    aria-label="Pagination"
  >
    <p class="text-xs text-foreground">
      {{ 'pagination.summary'|trans({
        '%start%': pagination.currentPageOffsetStart,
        '%end%': pagination.currentPageOffsetEnd,
        '%total%': pagination.nbResults,
      }) }}
    </p>

    <div class="flex shrink-0 gap-3">
      {% if pagination.hasPreviousPage %}
        <a
          href="{{ path(
            app.request.attributes.get('_route'),
            app.request.query.all|merge({
              page: pagination.previousPage,
            }),
          ) }}"
          class="{{ buttonEnabled }}"
          title="{{ 'pagination.previous'|trans }}"
          aria-label="{{ 'pagination.previous'|trans }}"
        >
          {{ ux_icon('lucide:chevron-left', { class: 'size-4' }) }}
        </a>
      {% else %}
        <span
          class="{{ buttonDisabled }}"
          title="{{ 'pagination.previous'|trans }}"
          aria-label="{{ 'pagination.previous'|trans }}"
          aria-disabled="true"
        >
          {{ ux_icon('lucide:chevron-left', { class: 'size-4' }) }}
        </span>
      {% endif %}

      {% if pagination.hasNextPage %}
        <a
          href="{{ path(
            app.request.attributes.get('_route'),
            app.request.query.all|merge({
              page: pagination.nextPage,
            }),
          ) }}"
          class="{{ buttonEnabled }}"
          title="{{ 'pagination.next'|trans }}"
          aria-label="{{ 'pagination.next'|trans }}"
        >
          {{ ux_icon('lucide:chevron-right', { class: 'size-4' }) }}
        </a>
      {% else %}
        <span
          class="{{ buttonDisabled }}"
          title="{{ 'pagination.next'|trans }}"
          aria-label="{{ 'pagination.next'|trans }}"
          aria-disabled="true"
        >
          {{ ux_icon('lucide:chevron-right', { class: 'size-4' }) }}
        </span>
      {% endif %}
    </div>
  </nav>
{% endif %}
