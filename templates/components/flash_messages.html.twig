{#
  Session flash messages (include once per layout).

  Expected flash labels: success, warning, error.
  Unknown labels fall back to info styling.
#}

{% set flashStyles = {
  success: {
    icon: 'lucide:circle-check',
    tone: 'bg-success border-success-line text-success-foreground',
  },
  warning: {
    icon: 'lucide:triangle-alert',
    tone: 'bg-warning border-warning-line text-warning-foreground',
  },
  error: {
    icon: 'lucide:circle-alert',
    tone: 'bg-danger border-danger-line text-danger-foreground',
  },
} %}

{% set flashStyleFallback = {
  icon: 'lucide:circle-alert',
  tone: 'bg-surface border-line text-foreground',
} %}

{% set flashDismissAfter = {
  success: 5000,
  warning: 0,
  error: 0,
} %}

{% set flashes = app.flashes %}

{% if flashes is not empty %}
  <div
    class="shrink-0 space-y-2 mb-2"
    aria-live="polite"
    data-controller="flash-messages"
    data-action="flash-message:dismissed->flash-messages#onDismissed"
  >
    {% for label, messages in flashes %}
      {% set flashStyle = flashStyles[label] ?? flashStyleFallback %}
      {% set dismissAfter = flashDismissAfter[label] ?? 0 %}

      {% for message in messages %}
        <div
          role="alert"
          class="
            flex items-center gap-1.5
            pl-4 pr-2 py-2 border rounded text-sm
            {{ flashStyle.tone }}
          "
          data-controller="flash-message"
          data-flash-message-dismiss-after-value="{{ dismissAfter }}"
          data-action="
            mouseenter->flash-message#pauseTimer
            mouseleave->flash-message#resumeTimer
            focusin->flash-message#pauseTimer
            focusout->flash-message#resumeTimer
          "
        >
          {{ ux_icon(flashStyle.icon, { class: 'shrink-0 size-4' }) }}
          <span class="flex-1 min-w-0">
            {{ message }}
          </span>

          <button
            type="button"
            class="
              inline-flex items-center justify-center shrink-0
              w-8 h-8 bg-transparent rounded
              transition select-none
              focus:outline-none focus:ring-2 focus:ring-outline
            "
            aria-label="{{ 'flash.close'|trans }}"
            data-action="click->flash-message#dismiss"
          >
            {{ ux_icon('lucide:x', { class: 'size-4' }) }}
          </button>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
{% endif %}
