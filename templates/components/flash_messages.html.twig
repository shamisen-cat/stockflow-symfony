{#
  Session flash messages (include once per layout).

  Expected flash labels: success, warning, error.
  Unknown labels fall back to info styling.
#}

{% set flashStyles = {
  success: {
    icon: 'lucide:circle-check',
    bg: 'bg-emerald-50',
    borderColor: 'border-emerald-200',
    textColor: 'text-emerald-700',
  },
  warning: {
    icon: 'lucide:triangle-alert',
    bg: 'bg-amber-50',
    borderColor: 'border-amber-200',
    textColor: 'text-amber-700',
  },
  error: {
    icon: 'lucide:circle-alert',
    bg: 'bg-red-50',
    borderColor: 'border-red-200',
    textColor: 'text-red-700',
  },
} %}

{% set flashStyleFallback = {
  icon: 'lucide:circle-alert',
  bg: 'bg-white',
  borderColor: 'border-slate-200',
  textColor: 'text-slate-700',
} %}

{% set flashDismissAfter = {
  success: 5000,
  warning: 0,
  error: 0,
} %}

{% set flashes = app.flashes %}

{% if flashes is not empty %}
  <div
    class="
      space-y-2
      px-4 pb-2
      shrink-0
    "
    aria-live="polite"
    data-controller="flash-messages"
    data-action="flash-message:dismissed->flash-messages#onDismissed"
  >
    {% for label, messages in flashes %}
      {% set flashStyle = flashStyles[label] ?? flashStyleFallback %}
      {% set dismissAfter = flashDismissAfter[label] ?? 0 %}

      {% for message in messages %}
        <div
          role="alert"
          class="
            flex
            items-center
            gap-1.5
            p-2 pl-4
            {{ flashStyle.bg }}
            border
            {{ flashStyle.borderColor }}
            rounded
            text-sm
            {{ flashStyle.textColor }}
          "
          data-controller="flash-message"
          data-flash-message-dismiss-after-value="{{ dismissAfter }}"
          data-action="
            mouseenter->flash-message#pauseTimer
            mouseleave->flash-message#resumeTimer
            focusin->flash-message#pauseTimer
            focusout->flash-message#resumeTimer
          "
        >
          {{ ux_icon(
            flashStyle.icon,
            { class: 'size-4 shrink-0' },
          ) }}

          <span
            class="
              flex-1
              min-w-0
            "
          >
            {{ message }}
          </span>

          <button
            type="button"
            class="
              inline-flex
              items-center justify-center
              w-8 h-8
              shrink-0
              hover:bg-black/5
              rounded
              focus:outline-none
              focus:ring-2
              focus:ring-blue-400
              opacity-70 hover:opacity-100 focus:opacity-100
              transition
              select-none
            "
            aria-label="{{ 'flash.close'|trans }}"
            data-action="click->flash-message#dismiss"
          >
            {{ ux_icon(
              'lucide:x',
              { class: 'size-4' },
            ) }}
          </button>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
{% endif %}
