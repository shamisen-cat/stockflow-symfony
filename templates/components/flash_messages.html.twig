{#
  Session flash messages (include once per layout).

  Expected flash labels: success, error, warning.
  Unknown labels fall back to info styling.
#}

{% set flashStyles = {
  success: {
    icon: 'lucide:circle-check',
    box: '
      bg-emerald-50
      border-emerald-200
      text-emerald-700
    ',
  },
  warning: {
    icon: 'lucide:triangle-alert',
    box: '
      bg-amber-50
      border-amber-200
      text-amber-700
    ',
  },
  error: {
    icon: 'lucide:circle-alert',
    box: '
      bg-red-50
      border-red-200
      text-red-700
    ',
  },
} %}

{% set flashStyleFallback = {
  icon: 'lucide:circle-alert',
  box: '
    bg-slate-50
    border-slate-200
    text-slate-700
  ',
} %}

{% set flashDismissAfter = {
  success: 5000,
  warning: 0,
  error: 0,
} %}

{% set flashes = app.flashes %}

{% if flashes is not empty %}
  <div
    class="
      space-y-2
      shrink-0
      px-4 pb-2
    "
    aria-live="polite"
    data-controller="flash-messages"
    data-action="flash-message:dismissed->flash-messages#onDismissed"
  >
    {% for label, messages in flashes %}
      {% set flashStyle = flashStyles[label] ?? flashStyleFallback %}
      {% set dismissAfter = flashDismissAfter[label] ?? 0 %}

      {% for message in messages %}
        <div
          role="alert"
          class="
            flex
            items-center
            gap-1
            pl-4 pr-2 py-2
            border
            rounded-lg
            text-sm
            {{ flashStyle.box }}
          "
          data-controller="flash-message"
          data-flash-message-dismiss-after-value="{{ dismissAfter }}"
          data-action="
            mouseenter->flash-message#pauseTimer
            mouseleave->flash-message#resumeTimer
            focusin->flash-message#pauseTimer
            focusout->flash-message#resumeTimer
          "
        >
          {{ ux_icon(
            flashStyle.icon,
            { class: 'shrink-0 size-4' },
          ) }}

          <span
            class="
              flex-1
              min-w-0
            "
          >
            {{ message }}
          </span>

          <button
            type="button"
            class="
              inline-flex
              items-center justify-center
              shrink-0
              w-7 h-7
              hover:bg-black/5
              rounded
              focus:outline-none
              focus:ring-2 focus:ring-current
              opacity-70 hover:opacity-100 focus:opacity-100
              transition
            "
            aria-label="{{ 'flash.close'|trans }}"
            data-action="click->flash-message#dismiss"
          >
            {{ ux_icon(
              'lucide:x',
              { class: 'size-4' },
            ) }}
          </button>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
{% endif %}
